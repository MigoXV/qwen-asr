{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Qwen ASR: vLLM",
            "type": "debugpy",
            "request": "launch",
            "module": "qwen_asr.commands.app",
            "args": ["vllm"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
                "VLLM_WORKER_MULTIPROC_METHOD": "spawn"
            }
        },
        {
            "name": "Qwen ASR: Transformers",
            "type": "debugpy",
            "request": "launch",
            "module": "qwen_asr.commands.app",
            "args": ["transformers"],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
