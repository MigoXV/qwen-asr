QWEN_ASR_MODEL=/root/repositories/qwen-asr/model-bin/Qwen/Qwen3-ASR-0.6B
QWEN_ASR_SERVER_PORT=50011
# 单模型的 vLLM max_num_seqs；不会增加模型副本。
QWEN_ASR_WORKERS=4
QWEN_ASR_MAX_CONCURRENT_RPCS=32
QWEN_ASR_MEMORY_UTILIZATION=0.10
QWEN_ASR_VLLM_MAX_MODEL_LEN=1024
QWEN_ASR_VLLM_MAX_NUM_BATCHED_TOKENS=4096
QWEN_ASR_MAX_NEW_TOKENS=256
QWEN_ASR_VLLM_ENFORCE_EAGER=false
QWEN_ASR_ASCEND_GRAPH_MODE=FULL_DECODE_ONLY
QWEN_ASR_VLLM_ASYNC_SCHEDULING=true
