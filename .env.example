# 两个后端共用的配置
QWEN_ASR_MODEL=/model-bin/Qwen/Qwen3-ASR-0.6B
QWEN_ASR_CONTEXT=
QWEN_ASR_SERVER_PORT=50051
QWEN_ASR_MAX_NEW_TOKENS=256
QWEN_ASR_DEVICE=cuda

# 仅 vLLM 后端使用
QWEN_ASR_VLLM_GPU_MEMORY_UTILIZATION=0.27
QWEN_ASR_VLLM_MAX_MODEL_LEN=1536
QWEN_ASR_VLLM_MAX_NUM_SEQS=4
QWEN_ASR_VLLM_MAX_NUM_BATCHED_TOKENS=1536
QWEN_ASR_VLLM_ENFORCE_EAGER=false
